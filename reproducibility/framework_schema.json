{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/egeas/framework_schema.json",
  "title": "Evidence-Gated Evaluation of Agentic Systems Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "system",
    "claims",
    "authority",
    "protocol",
    "evidence"
  ],
  "properties": {
    "bundle_version": {
      "const": "1.0"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "version", "artifact_digest"],
      "properties": {
        "system_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "version": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "metric", "threshold", "exclusions"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 10},
          "metric": {"type": "string", "minLength": 1},
          "threshold": {"type": "string", "minLength": 1},
          "exclusions": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "operations",
        "network",
        "credentials",
        "real_person_data",
        "external_effects",
        "approval_required"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "not": {"pattern": "\\*"}},
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "READ_SYNTHETIC_FIXTURE",
              "DRAFT_SYNTHETIC_OUTPUT",
              "PROPOSE_SYNTHETIC_ACTION",
              "SIMULATE_SYNTHETIC_DECISION"
            ]
          },
          "uniqueItems": true
        },
        "network": {"const": "DISABLED"},
        "credentials": {"const": "NONE"},
        "real_person_data": {"const": false},
        "external_effects": {"const": false},
        "approval_required": {"type": "boolean"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "frozen",
        "fixtures_digest",
        "scorer_digest",
        "expected_cases"
      ],
      "properties": {
        "protocol_id": {"type": "string", "pattern": "^PRO-[A-Z0-9_-]+$"},
        "frozen": {"const": true},
        "fixtures_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scorer_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "expected_cases": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_results_present",
        "environment_manifest_present",
        "exceptions",
        "independent_review"
      ],
      "properties": {
        "raw_results_present": {"type": "boolean"},
        "environment_manifest_present": {"type": "boolean"},
        "exceptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "independent_review": {
          "enum": ["NOT_PERFORMED", "PENDING", "COMPLETE"]
        }
      }
    }
  }
}
